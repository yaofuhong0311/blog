---

import { getTagList } from "../../utils/content-utils";
import { getTagUrl } from "../../utils/url-utils";
import ButtonTag from "../control/ButtonTag.astro";
import WidgetLayout from "./WidgetLayout.astro";

const allTags = await getTagList();
const featuredTagNames = [
	"AgentScope",
	"沙箱",
	"AI Agent",
	"AI Infra",
	"AI Coding",
];
const tags = featuredTagNames.flatMap((name) => {
	const tag = allTags.find((item) => item.name === name);
	return tag ? [tag] : [];
});

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---
<WidgetLayout name="重点主题" id="tags" isCollapsed={false} class={className} style={style}>
    <div class="flex gap-2 flex-wrap">
        {tags.map(t => (
            <ButtonTag href={getTagUrl(t.name)} label={`View all posts with the ${t.name.trim()} tag`}>
                {t.name.trim()}
            </ButtonTag>
        ))}
    </div>
</WidgetLayout>
